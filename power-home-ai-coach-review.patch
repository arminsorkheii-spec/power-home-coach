+export async function generate(input:unknown,provider:typeof callProvider=callProvider){const r=requestSchema.parse(input),db=aiDb(),owner=coachDataKey(),s=settings(),model=process.env.AI_COACH_MODEL??'';if(!s.enabled||!process.env.OPENAI_API_KEY||!model)throw Error('AI غیرفعال است؛ برنامه‌نویسی دستی در دسترس است.');if(s.rateModel!==model||!s.rateCheckedAt||s.inputUsdPerMillion<=0||s.outputUsdPerMillion<=0)throw Error('مدل و نرخ هزینه باید در تنظیمات تأیید شوند.');if(r.parentId&&getDraft(r.parentId).client_id!==r.clientId)throw Error('بازسازی برای شاگرد دیگری مجاز نیست.');const existing=db.prepare('SELECT fingerprint,status FROM ai_jobs WHERE id=? AND owner=?').bind(r.requestId,owner).first<{fingerprint:string;status:string}>();const hash=fingerprint(r);if(existing){if(existing.fingerprint!==hash)throw Error('شناسه درخواست با محتوای متفاوت تکرار شده است.');const row=db.prepare('SELECT * FROM ai_drafts WHERE request_id=? AND owner=?').bind(r.requestId,owner).first<DraftRow>();if(row)return draftView(row);throw Error('درخواست قبلی در حال اجرا یا نیازمند بررسی مصرف است؛ خودکار تکرار نشد.');}

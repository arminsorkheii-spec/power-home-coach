+const headers={'cache-control':'private,no-store'};export const maxDuration=120;
+export async function GET(r:Request){if(!await requestHasValidSession(r))return new Response(null,{status:401,headers});try{const id=new URL(r.url).searchParams.get('clientId')??'',{state}=ownedClient(id);if(process.env.AI_COACH_SCHEMA!=='1')return Response.json({enabled:false,reason:'ماژول غیرفعال است؛ ابتدا راهنمای محیط آزمایشی و Migration را اجرا کن.',systems:BUILTIN_SYSTEMS},{headers});const db=aiDb(),intake=db.prepare('SELECT profile_json FROM applications WHERE client_id=? ORDER BY created_at DESC LIMIT 1').bind(id).first<{profile_json:string}>(),profile=intake?JSON.parse(intake.profile_json):{},numeric=(value:unknown)=>{const n=Number(String(value??'').replace(/[۰-۹]/g,c=>String('۰۱۲۳۴۵۶۷۸۹'.indexOf(c))).replace(/[٠-٩]/g,c=>String('٠١٢٣٤٥٦٧٨٩'.indexOf(c))));return n>0?n:null},athleteInfo={age:numeric(profile.age),height:numeric(profile.height??state.clients.find(c=>c.id===id)?.initialMeasurements?.height),weight:numeric(profile.weight??state.clients.find(c=>c.id===id)?.initialMeasurements?.weight)},drafts=db.prepare('SELECT id,revision,status,created_at FROM ai_drafts WHERE owner=? AND client_id=? ORDER BY created_at DESC LIMIT 50').bind(coachDataKey(),id).all().results;return Response.json({athleteInfo,enabled:Boolean(process.env.OPENAI_API_KEY&&process.env.AI_COACH_MODEL&&settings().enabled),configured:Boolean(process.env.OPENAI_API_KEY&&process.env.AI_COACH_MODEL),model:process.env.AI_COACH_MODEL??'',settings:settings(),usage:usage(),systems:systems(),consent:consent(id),disclosure:CONSENT_TEXT,exercises:[...EXERCISES,...state.customExercises],foods:foodCatalog(),references:referenceOptions(),photos:photoOptions(id),drafts,golden:db.prepare('SELECT id,payload FROM ai_golden_rules WHERE owner=?').bind(coachDataKey()).all<{id:string;payload:string}>().results.map(g=>({id:g.id,title:decode<{title:string}>(g.payload).title}))},{headers})}catch{return Response.json({error:'اطلاعات AI یا پرونده شاگرد در دسترس نیست.'},{status:400,headers})}}
+const settingsSchema=z.object({enabled:z.boolean(),monthlyRequests:z.number().int().min(1).max(500),monthlyUsd:z.number().positive().max(10000),inputUsdPerMillion:z.number().min(0).max(1000),cachedUsdPerMillion:z.number().min(0).max(1000),outputUsdPerMillion:z.number().min(0).max(1000),rateModel:z.string().max(120),rateCheckedAt:z.string().max(40),maxOutputTokens:z.number().int().min(1000).max(16000)}).strict();
+export async function POST(r:Request){if(!sameOrigin(r)||!await requestHasValidSession(r))return new Response(null,{status:403,headers});try{const raw=await r.text();if(raw.length>250000)return new Response(null,{status:413,headers});const b=JSON.parse(raw),db=aiDb(),owner=coachDataKey();if(b.action==='generate')return Response.json(await generate(b.request),{headers});if(b.action==='settings'){const v=settingsSchema.parse(b.settings);db.prepare('INSERT INTO ai_settings(owner,payload) VALUES(?,?) ON CONFLICT(owner) DO UPDATE SET payload=excluded.payload').bind(owner,encode(v)).run();return Response.json({ok:true},{headers})}if(b.action==='system'){const v=systemSchema.parse(b.system);if(BUILTIN_SYSTEMS.some(s=>s.id===v.id))throw Error('شناسه بانک پیش‌فرض قابل بازنویسی نیست.');const old=db.prepare('SELECT owner FROM ai_systems WHERE id=?').bind(v.id).first<{owner:string}>();if(old&&old.owner!==owner)throw Error('سیستم غیرمجاز است.');db.prepare('INSERT INTO ai_systems(id,owner,payload,approved,updated_at) VALUES(?,?,?,?,?) ON CONFLICT(id) DO UPDATE SET payload=excluded.payload,approved=excluded.approved,updated_at=excluded.updated_at').bind(v.id,owner,encode(v),+v.approved,new Date().toISOString()).run();return Response.json({ok:true},{headers})}
+ if(b.action==='reconcile'){const v=z.object({id:z.string().uuid(),cost:z.number().min(0).max(10000),invoiceNote:z.string().min(5).max(1000),confirmed:z.literal(true)}).strict().parse(b.value);const row=db.prepare("SELECT rate_snapshot FROM ai_jobs WHERE id=? AND owner=? AND status IN ('pending','uncertain')").bind(v.id,owner).first<{rate_snapshot:string}>();if(!row)throw Error('مصرف نامشخص پیدا نشد.');db.prepare("UPDATE ai_jobs SET status='reconciled',cost_usd=?,rate_snapshot=?,updated_at=? WHERE id=? AND owner=?").bind(v.cost,JSON.stringify({...JSON.parse(row.rate_snapshot),reconciliation:v.invoiceNote,source:'manual-invoice'}),new Date().toISOString(),v.id,owner).run();return Response.json({ok:true},{headers})}
+ const id=z.string().uuid().parse(b.id),row=getDraft(id);if(b.action==='read')return Response.json(draftView(row),{headers});if(b.action==='history')return Response.json(db.prepare('SELECT revision,event,created_at,payload FROM ai_draft_versions WHERE draft_id=? ORDER BY revision DESC').bind(id).all<{revision:number;event:string;created_at:string;payload:string}>().results.map(v=>({...v,payload:decode(v.payload)})),{headers});const revision=z.number().int().positive().parse(b.revision);if(b.action==='edit')return Response.json(editDraft(id,revision,b.output,z.enum(['training','rest']).parse(b.dayType)),{headers});if(b.action==='approve'){if(b.confirmed!==true)throw Error('تأیید صریح لازم است.');return Response.json(approveDraft(id,revision),{headers})}if(b.action==='transfer'){if(b.confirmed!==true)throw Error('تأیید انتقال لازم است.');return Response.json(transferDraft(id,revision),{headers})}if(b.action==='golden'){if(row.revision!==revision||!['approved','transferred'].includes(row.status)||b.confirmed!==true)throw Error('فقط نمونه تأییدشده قابل ذخیره است.');const view=draftView(row),title=z.string().trim().min(1).max(150).parse(b.title),rules=z.string().trim().max(3000).parse(b.rules);const plan={workoutDays:view.plan.workoutDays,nutritionGoals:view.plan.nutritionGoals,nutritionMeals:view.plan.nutritionMeals};db.prepare('INSERT INTO ai_golden_rules(id,owner,source_draft_id,payload,created_at) VALUES(?,?,?,?,?)').bind(crypto.randomUUID(),owner,id,encode({title,rules,plan}),new Date().toISOString()).run();return Response.json({ok:true},{headers})}throw Error('عملیات ناشناخته است.');}catch(e){return Response.json({error:e instanceof z.ZodError?'ساختار ورودی معتبر نیست.':(e as Error).message},{status:400,headers})}}

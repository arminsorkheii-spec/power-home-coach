+export function editDraft(id:string,revision:number,output:unknown,dayType:'training'|'rest'){const db=aiDb();return db.transaction(()=>{const row=getDraft(id);if(row.revision!==revision||row.status==='transferred')throw Error('نسخه تغییر کرده است؛ دوباره دریافت کن.');const payload=decode<DraftPayload>(row.payload),{state}=ownedClient(row.client_id);payload.output=validateOutput(output,payload.request,[...EXERCISES,...state.customExercises],foodCatalog());payload.dayType=dayType;const now=new Date().toISOString(),sealed=encode(payload);db.prepare("UPDATE ai_drafts SET revision=revision+1,payload=?,status='draft',approved_hash=NULL,updated_at=? WHERE id=?").bind(sealed,now,id).run();db.prepare('INSERT INTO ai_draft_versions(id,draft_id,revision,payload,event,created_at) VALUES(?,?,?,?,?,?)').bind(randomUUID(),id,revision+1,sealed,'edited',now).run();return {ok:true}})}

+export function validateOutput(value:unknown,r:GenerationRequest,catalog:Exercise[],foods:CatalogFood[]){const o=outputSchema.parse(value);if(prohibited.test(JSON.stringify(o)))throw Error('پیشنهاد دارویی یا پرخطر مجاز نیست.');for(const engine of r.engines)if(o[engine]===null)throw Error('خروجی موتور انتخاب‌شده ناقص است.');if(o.visual.some(v=>/[0-9۰-۹]/.test(v.observation)))throw Error('اندازه یا درصد دقیق از تصویر مجاز نیست.');if(!r.photoIds.length&&o.visual.length)throw Error('تحلیل تصویری بدون تصویر مجاز نیست.');if(o.training){if(o.training.length!==r.training.sessions)throw Error('تعداد روزها تغییر کرده است.');const seen=new Set<string>(),frequency=new Map<string,Set<number>>(),sets=new Map<string,number>();o.training.forEach((d,i)=>{if(d.exercises.reduce((n,e)=>n+e.sets,0)>40)throw Error('حجم ست اصلی جلسه بیش از سقف بازبینی است.');if(['method-0','method-1'].includes(r.training.methodId)&&d.exercises.some(e=>e.sets!==1))throw Error('روش کم‌حجم انتخابی فقط یک ست اصلی برای هر حرکت دارد.');if(r.training.methodId==='method-2'&&(d.exercises.at(-1)?.sets!==7||r.training.restSeconds<30||r.training.restSeconds>45))throw Error('FST-7 به هفت ست پایانی و استراحت انتخابی۳۰تا۴۵ثانیه نیاز دارد.');if(r.training.methodId==='method-3'&&(d.exercises[0].sets!==10||d.exercises[0].reps!==10))throw Error('حرکت اصلی GVT باید۱۰ست۱۰تکرار باشد.');if(d.title!==r.training.customDays[i])throw Error('تقسیم روزها بدون تأیید مربی تغییر کرده است.');for(const e of d.exercises){const item=catalog.find(x=>x.id===e.exerciseId);if(!item||!r.training.allowedExerciseIds.includes(e.exerciseId)||r.training.forbiddenExerciseIds.includes(e.exerciseId))throw Error('حرکت غیرمجاز در خروجی است.');if(e.sets>r.training.maxSets||e.rir!==r.training.rir||e.rpe!==r.training.rpe||e.restSeconds!==r.training.restSeconds||e.techniqueIds.some(t=>!r.training.techniqueIds.includes(t)))throw Error('قواعد ست، شدت یا استراحت رعایت نشده است.');seen.add(e.exerciseId);const muscle=movementMuscle(item.nameFa,item.category);if(m